      "priority": 2,
      "passes": false,
      "runner": "shell",
      "command": "python3 -m mypy src/harness --ignore-missing-imports || true",
      "timeout": 60
    },
    {
      "id": "shell-task-3",
      "title": "Count lines of code",
      "description": "Count lines of Python code",
      "priority": 3,
      "passes": false,
      "runner": "shell",
      "command": "find src -name '*.py' -exec wc -l {} + | tail -1",
      "timeout": 30
    }
  ],
